{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter web",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--web-renderer",
        "html",
        "-d",
        "chrome",
        "--web-browser-flag",
        "--disable-web-security",
        "--dart-define-from-file=config.json"
      ]
    }
  ]
}
